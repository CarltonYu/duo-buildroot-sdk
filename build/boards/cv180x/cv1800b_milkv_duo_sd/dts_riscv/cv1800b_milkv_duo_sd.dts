/dts-v1/;
#include "cv180x_base_riscv.dtsi"
#include "cv180x_asic_qfn.dtsi"
#include "cv180x_asic_sd.dtsi"
#include "cv180x_default_memmap.dtsi"

&mipi_rx{
	snsr-reset = <&portc 8 GPIO_ACTIVE_LOW>, <&portc 8 GPIO_ACTIVE_LOW>, <&portc 8 GPIO_ACTIVE_LOW>;
};

&spi2 {
	status = "okay";
	num-cs = <2>;
	/*
	 * Both chip-selects are GPIO-controlled because the DesignWare SPI
	 * controller on CV1800B only has a single native CS line (CS0) and
	 * cannot drive the shift engine for chip-select 1.  We keep CS0
	 * selected in hardware SER and toggle the actual GPIOs from software.
	 */
	cs-gpios = <&porte 18 GPIO_ACTIVE_LOW>,   /* Pin12: GP9 / PWR_GPIO_18, ST7789V */
	           <&porte 4 GPIO_ACTIVE_LOW>;    /* Pin29: GP22 / PWR_GPIO_4,  GC9A01  */
	/delete-node/ spidev@0;

	/*
	 * ST7789V 240x320 LCD on SPI2 SCK/MOSI, GPIO CS on Pin12.
	 * Probed by the built-in fbtft ST7789V driver as /dev/fb0.
	 */
	st7789v: display@0 {
		compatible = "sitronix,st7789v";
		reg = <0>;
		status = "okay";
		/* SPI mode 0, 32 MHz. ST7789V datasheet max is ~62.5 MHz;
		 * 32 MHz is a safe starting point with the current wiring.
		 */
		spi-max-frequency = <32000000>;
		/* Mode 0: CPOL=0, CPHA=0 (default when spi-cpol/spi-cpha absent) */
		width = <240>;
		height = <320>;
		rotate = <270>;
		fps = <30>;
		buswidth = <8>;
		reset-gpios = <&porta 23 GPIO_ACTIVE_LOW>;  /* Duo Pin 21: XGPIOA_23, ST7789V RST */
		dc-gpios    = <&porta 24 GPIO_ACTIVE_HIGH>; /* Duo Pin 22: XGPIOA_24, ST7789V DC  */
		bgr;
		/*
		 * Pin5/Pin11 (PWR_GPIO_25/21) are kept free for the GC9A01 DC/RST in
		 * user-space.  The default GPIO mux already assigns Pin21/Pin22 as
		 * XGPIOA_23/XGPIOA_24.
		 */
	};

	/*
	 * GC9A01 240x240 round LCD is driven from user-space via /dev/spidev0.1.
	 * Its chip-select is managed by the SPI core on Duo Pin29 GP22 (PWR_GPIO_4,
	 * porte offset 4).  The user-space animation program no longer toggles CS.
	 */
	gc9a01_spi: spidev@1 {
		compatible = "rohm,dh2228fv";
		reg = <1>;
		status = "okay";
		spi-max-frequency = <12000000>;
	};
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&uart4 {
	status = "okay";
};

&i2c1 {
       status = "okay";
       clock-frequency = <100000>;
};

/ {
	model = "Milk-V Duo";
};
